from collections.abc import Sequence
from types import TracebackType
from typing import Any, Final, Literal, TypeAlias, final

from typing_extensions import Self

_Value: TypeAlias = int | float | str | bytes | None
_Parameters: TypeAlias = Sequence[_Value]
_Row: TypeAlias = tuple[Any, ...]
_Description: TypeAlias = tuple[tuple[str, None, None, None, None, None, None], ...]

LEGACY_TRANSACTION_CONTROL: Final[int]
paramstyle: Final = "qmark"
sqlite_version_info: Final[tuple[int, int, int]]

class Error(ValueError): ...
class InterfaceError(Error): ...
class DatabaseError(Error): ...
class DataError(DatabaseError): ...
class OperationalError(DatabaseError): ...
class IntegrityError(DatabaseError): ...
class InternalError(DatabaseError): ...
class ProgrammingError(DatabaseError): ...
class NotSupportedError(DatabaseError): ...

def connect(
    database: str,
    timeout: float = 5.0,
    isolation_level: str | None = "DEFERRED",
    _check_same_thread: bool = True,
    _uri: bool = False,
    sync_url: str | None = None,
    sync_interval: float | None = None,
    offline: bool = False,
    auth_token: str = "",
    encryption_key: str | None = None,
    # Only accepted on Python 3.12+ (mirrors sqlite3.connect).
    autocommit: int = ...,
) -> Connection: ...

@final
class Connection:
    isolation_level: str | None
    # Only available on Python 3.12+ (mirrors sqlite3.Connection.autocommit).
    autocommit: int
    @property
    def in_transaction(self) -> bool: ...
    def close(self) -> None: ...
    def cursor(self) -> Cursor: ...
    def sync(self) -> None: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def execute(self, sql: str, parameters: _Parameters | None = None) -> Cursor: ...
    def executemany(
        self, sql: str, parameters: list[_Parameters] | None = None
    ) -> Cursor: ...
    def executescript(self, script: str) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None = None,
        _exc_val: BaseException | None = None,
        _exc_tb: TracebackType | None = None,
    ) -> Literal[False]: ...

@final
class Cursor:
    arraysize: int
    @property
    def description(self) -> _Description | None: ...
    @property
    def lastrowid(self) -> int | None: ...
    @property
    def rowcount(self) -> int: ...
    def close(self) -> None: ...
    def execute(self, sql: str, parameters: _Parameters | None = None) -> Self: ...
    def executemany(
        self, sql: str, parameters: list[_Parameters] | None = None
    ) -> Self: ...
    def executescript(self, script: str) -> Self: ...
    def fetchone(self) -> _Row | None: ...
    def fetchmany(self, size: int | None = None) -> list[_Row] | None: ...
    def fetchall(self) -> list[_Row] | None: ...
